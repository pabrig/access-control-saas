# Copy to .env.local
# Same hosted Supabase keys as apps/web.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_OR_PUBLISHABLE_KEY

# Local dev: leave both unset — /access rewrites to http://127.0.0.1:4000 (pnpm dev).
# Production (Vercel): set ACCESS_API_URL to your API host (server-only, no NEXT_PUBLIC_).
# ACCESS_API_URL=https://nexo-api.onrender.com

# Advanced local dev only — bypass rewrite and call API directly (needs CORS on API):
# NEXT_PUBLIC_API_URL=http://127.0.0.1:4000
