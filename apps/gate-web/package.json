{
  "name": "gate-web",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "env -u DYLD_INSERT_LIBRARIES next dev --port 3002 --hostname 0.0.0.0",
    "dev:https": "env -u DYLD_INSERT_LIBRARIES next dev --port 3002 --hostname 0.0.0.0 --experimental-https",
    "build": "next build",
    "start": "env -u DYLD_INSERT_LIBRARIES next start --port 3002",
    "lint": "eslint --max-warnings 0",
    "check-types": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@repo/db": "workspace:*",
    "@repo/observability": "workspace:*",
    "@repo/ui": "workspace:*",
    "@sentry/nextjs": "^10.72.0",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.57.4",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "jsqr": "^1.4.0",
    "next": "16.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^22.15.3",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "eslint": "^9.39.1",
    "typescript": "5.9.2"
  }
}
