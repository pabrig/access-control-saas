{
  "name": "access-control-saas",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --filter=web --filter=api",
    "dev:all": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "ci": "turbo run lint check-types build",
    "db:login": "supabase login",
    "db:link": "supabase link --project-ref",
    "db:push": "supabase db push --linked",
    "db:seed": "supabase db query --linked -f supabase/seed.sql",
    "db:types": "supabase gen types typescript --linked --schema public > packages/db/src/database.ts",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:studio": "open http://127.0.0.1:54323",
    "db:types:local": "supabase gen types typescript --local --schema public > packages/db/src/database.ts",
    "db:test": "supabase test db"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "supabase": "^2.115.0",
    "turbo": "^2.10.1",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  }
}
