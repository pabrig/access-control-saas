{
  "name": "access-control-saas",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:studio": "open http://127.0.0.1:54323",
    "db:types": "supabase gen types typescript --local --schema public > packages/db/src/database.ts",
    "db:test": "supabase test db"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "supabase": "^2.115.0",
    "turbo": "^2.10.1",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  }
}
